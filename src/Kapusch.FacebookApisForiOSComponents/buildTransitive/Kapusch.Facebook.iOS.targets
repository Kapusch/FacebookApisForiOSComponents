<Project>
  <PropertyGroup>
    <!-- Package .props are imported before the consuming project body. Resolve the
         selected features here, after the consumer had a chance to override them. -->
    <_KapuschFacebookFeaturesDelimited>;$([System.String]::Copy('$(KapuschFacebookFeatures)').Replace(' ', ''));</_KapuschFacebookFeaturesDelimited>
    <_KapuschFacebookLoginEnabled>$([System.String]::Copy('$(_KapuschFacebookFeaturesDelimited)').Contains(';Login;'))</_KapuschFacebookLoginEnabled>
    <_KapuschFacebookShareEnabled>$([System.String]::Copy('$(_KapuschFacebookFeaturesDelimited)').Contains(';Share;'))</_KapuschFacebookShareEnabled>
    <!-- App Events only needs CoreKit, which every selection links, so its facade is always linked.
         Selecting AppEvents alone yields a CoreKit-only build (no LoginKit, no ShareKit). -->
    <_KapuschFacebookAppEventsEnabled>$([System.String]::Copy('$(_KapuschFacebookFeaturesDelimited)').Contains(';AppEvents;'))</_KapuschFacebookAppEventsEnabled>
    <_KapuschFacebookInteropPackageRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))</_KapuschFacebookInteropPackageRoot>
  </PropertyGroup>
  <PropertyGroup Condition="'$(UseKapuschFacebookInteropFromSource)' == 'true'">
    <_KapuschFacebookInteropSourceRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../Native/iOS/build'))</_KapuschFacebookInteropSourceRoot>
  </PropertyGroup>
  <Target
    Name="KapuschFacebookInterop_ValidateFeatures"
    BeforeTargets="CoreCompile"
    Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'"
  >
    <ItemGroup>
      <_KapuschFacebookRequestedFeature Include="$([MSBuild]::Unescape($(KapuschFacebookFeatures.Replace(' ', ''))))" />
      <!-- String.Equals(string) is ordinal: feature names are matched case-sensitively, like the parsing above. -->
      <_KapuschFacebookUnknownFeature
        Include="@(_KapuschFacebookRequestedFeature)"
        Condition="!$([System.String]::Copy('%(Identity)').Equals('Login')) and !$([System.String]::Copy('%(Identity)').Equals('Share')) and !$([System.String]::Copy('%(Identity)').Equals('AppEvents'))"
      />
    </ItemGroup>
    <Warning
      Condition="'@(_KapuschFacebookUnknownFeature)' != ''"
      Text="Kapusch.Facebook.iOS: unknown KapuschFacebookFeatures value(s) '@(_KapuschFacebookUnknownFeature)'. Supported values (case-sensitive): Login, Share, AppEvents."
    />
  </Target>
  <Target
    Name="KapuschFacebookInterop_InjectIosNativeReferences_Source"
    BeforeTargets="CoreCompile"
    Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' and '$(DisableKapuschFacebookInteropNativeAssets)' != 'true' and '$(UseKapuschFacebookInteropFromSource)' == 'true'"
  >
    <PropertyGroup>
      <_KapuschFacebookInteropIosWrapper>$([System.IO.Path]::Combine('$(_KapuschFacebookInteropSourceRoot)', 'kfb.xcframework'))</_KapuschFacebookInteropIosWrapper>
	  <_KapuschFacebookShareInteropIosWrapper>$([System.IO.Path]::Combine('$(_KapuschFacebookInteropSourceRoot)', 'kfbshare.xcframework'))</_KapuschFacebookShareInteropIosWrapper>
	  <_KapuschFacebookShareStubIosWrapper>$([System.IO.Path]::Combine('$(_KapuschFacebookInteropSourceRoot)', 'kfbsharestub.xcframework'))</_KapuschFacebookShareStubIosWrapper>
	  <_KapuschFacebookAppEventsIosWrapper>$([System.IO.Path]::Combine('$(_KapuschFacebookInteropSourceRoot)', 'kfbappevents.xcframework'))</_KapuschFacebookAppEventsIosWrapper>
      <_KapuschFacebookInteropFbDir>$([System.IO.Path]::Combine('$(_KapuschFacebookInteropSourceRoot)', 'fb'))</_KapuschFacebookInteropFbDir>
      <_KapuschFacebookInteropSlice Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('iossimulator'))">ios-arm64_x86_64-simulator</_KapuschFacebookInteropSlice>
      <_KapuschFacebookInteropSlice Condition="'$(_KapuschFacebookInteropSlice)' == ''">ios-arm64</_KapuschFacebookInteropSlice>
    </PropertyGroup>
    <Error
	  Condition="'$(_KapuschFacebookLoginEnabled)' == 'True' and !Exists('$(_KapuschFacebookInteropIosWrapper)')"
      Text="Kapusch.Facebook.iOS source-mode: missing wrapper xcframework at '$(_KapuschFacebookInteropIosWrapper)'. Build it first via src/Kapusch.FacebookApisForiOSComponents/Native/iOS/build.sh."
    />
	<Error
	  Condition="'$(_KapuschFacebookShareEnabled)' == 'True' and !Exists('$(_KapuschFacebookShareInteropIosWrapper)')"
	  Text="Kapusch.Facebook.iOS source-mode: missing share wrapper xcframework at '$(_KapuschFacebookShareInteropIosWrapper)'. Build it first via src/Kapusch.FacebookApisForiOSComponents/Native/iOS/build.sh."
	/>
	<Error
	  Condition="'$(_KapuschFacebookShareEnabled)' != 'True' and !Exists('$(_KapuschFacebookShareStubIosWrapper)')"
	  Text="Kapusch.Facebook.iOS source-mode: missing share placeholder xcframework at '$(_KapuschFacebookShareStubIosWrapper)'. Build it first via src/Kapusch.FacebookApisForiOSComponents/Native/iOS/build.sh."
	/>
	<Error
	  Condition="!Exists('$(_KapuschFacebookAppEventsIosWrapper)')"
	  Text="Kapusch.Facebook.iOS source-mode: missing App Events wrapper xcframework at '$(_KapuschFacebookAppEventsIosWrapper)'. Build it first via src/Kapusch.FacebookApisForiOSComponents/Native/iOS/build.sh."
	/>
    <Error
      Condition="!Exists('$(_KapuschFacebookInteropFbDir)')"
      Text="Kapusch.Facebook.iOS source-mode: missing Facebook xcframeworks dir at '$(_KapuschFacebookInteropFbDir)'. Run src/Kapusch.FacebookApisForiOSComponents/Native/iOS/collect-facebook-xcframeworks.sh."
    />
    <ItemGroup>
	  <NativeReference Include="$(_KapuschFacebookInteropIosWrapper)" Condition="'$(_KapuschFacebookLoginEnabled)' == 'True'">
        <Kind>Static</Kind>
        <ForceLoad>true</ForceLoad>
      </NativeReference>
	  <NativeReference Include="$(_KapuschFacebookShareInteropIosWrapper)" Condition="'$(_KapuschFacebookShareEnabled)' == 'True'">
		<Kind>Static</Kind>
		<ForceLoad>true</ForceLoad>
	  </NativeReference>
	  <!-- NativeFacebookShare uses static __Internal imports, so its symbols must link even when Share is not selected. -->
	  <NativeReference Include="$(_KapuschFacebookShareStubIosWrapper)" Condition="'$(_KapuschFacebookShareEnabled)' != 'True'">
		<Kind>Static</Kind>
		<ForceLoad>true</ForceLoad>
	  </NativeReference>
	  <!-- App Events only needs FBSDKCoreKit, which every selection links, and FacebookAppEvents uses static __Internal imports. -->
	  <NativeReference Include="$(_KapuschFacebookAppEventsIosWrapper)">
		<Kind>Static</Kind>
		<ForceLoad>true</ForceLoad>
	  </NativeReference>
      <NativeReference Include="$(_KapuschFacebookInteropFbDir)/FBAEMKit.xcframework">
        <Kind>Framework</Kind>
        <ForceLoad>true</ForceLoad>
      </NativeReference>
      <NativeReference Include="$(_KapuschFacebookInteropFbDir)/FBSDKCoreKit.xcframework">
        <Kind>Framework</Kind>
        <ForceLoad>true</ForceLoad>
      </NativeReference>
      <NativeReference Include="$(_KapuschFacebookInteropFbDir)/FBSDKCoreKit_Basics.xcframework">
        <Kind>Framework</Kind>
        <ForceLoad>true</ForceLoad>
      </NativeReference>
	  <NativeReference Include="$(_KapuschFacebookInteropFbDir)/FBSDKLoginKit.xcframework" Condition="'$(_KapuschFacebookLoginEnabled)' == 'True'">
		<Kind>Framework</Kind>
		<ForceLoad>true</ForceLoad>
	  </NativeReference>
	  <NativeReference Include="$(_KapuschFacebookInteropFbDir)/FBSDKShareKit.xcframework" Condition="'$(_KapuschFacebookShareEnabled)' == 'True'">
        <Kind>Framework</Kind>
        <ForceLoad>true</ForceLoad>
      </NativeReference>
	  <BundleResource Include="$(_KapuschFacebookInteropFbDir)/FBAEMKit.xcframework/$(_KapuschFacebookInteropSlice)/FBAEMKit.framework/PrivacyInfo.xcprivacy" LogicalName="FBAEMKit_PrivacyInfo.xcprivacy" />
	  <BundleResource Include="$(_KapuschFacebookInteropFbDir)/FBSDKCoreKit.xcframework/$(_KapuschFacebookInteropSlice)/FBSDKCoreKit.framework/PrivacyInfo.xcprivacy" LogicalName="FBSDKCoreKit_PrivacyInfo.xcprivacy" />
	  <BundleResource Include="$(_KapuschFacebookInteropFbDir)/FBSDKCoreKit_Basics.xcframework/$(_KapuschFacebookInteropSlice)/FBSDKCoreKit_Basics.framework/PrivacyInfo.xcprivacy" LogicalName="FBSDKCoreKit_Basics_PrivacyInfo.xcprivacy" />
	  <BundleResource Include="$(_KapuschFacebookInteropFbDir)/FBSDKLoginKit.xcframework/$(_KapuschFacebookInteropSlice)/FBSDKLoginKit.framework/PrivacyInfo.xcprivacy" LogicalName="FBSDKLoginKit_PrivacyInfo.xcprivacy" Condition="'$(_KapuschFacebookLoginEnabled)' == 'True'" />
	  <BundleResource Include="$(_KapuschFacebookInteropFbDir)/FBSDKShareKit.xcframework/$(_KapuschFacebookInteropSlice)/FBSDKShareKit.framework/PrivacyInfo.xcprivacy" LogicalName="FBSDKShareKit_PrivacyInfo.xcprivacy" Condition="'$(_KapuschFacebookShareEnabled)' == 'True'" />
    </ItemGroup>
  </Target>
  <Target
    Name="KapuschFacebookInterop_InjectIosNativeReferences"
    BeforeTargets="CoreCompile"
    Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' and '$(DisableKapuschFacebookInteropNativeAssets)' != 'true' and '$(UseKapuschFacebookInteropFromSource)' != 'true'"
  >
    <PropertyGroup>
      <_KapuschFacebookInteropIosWrapper>$([System.IO.Path]::Combine('$(_KapuschFacebookInteropPackageRoot)', 'kfb.xcframework'))</_KapuschFacebookInteropIosWrapper>
	  <_KapuschFacebookShareInteropIosWrapper>$([System.IO.Path]::Combine('$(_KapuschFacebookInteropPackageRoot)', 'kfbshare.xcframework'))</_KapuschFacebookShareInteropIosWrapper>
	  <_KapuschFacebookShareStubIosWrapper>$([System.IO.Path]::Combine('$(_KapuschFacebookInteropPackageRoot)', 'kfbsharestub.xcframework'))</_KapuschFacebookShareStubIosWrapper>
	  <_KapuschFacebookAppEventsIosWrapper>$([System.IO.Path]::Combine('$(_KapuschFacebookInteropPackageRoot)', 'kfbappevents.xcframework'))</_KapuschFacebookAppEventsIosWrapper>
      <_KapuschFacebookInteropFbDir>$([System.IO.Path]::Combine('$(_KapuschFacebookInteropPackageRoot)', 'fb'))</_KapuschFacebookInteropFbDir>
      <_KapuschFacebookInteropSlice Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('iossimulator'))">ios-arm64_x86_64-simulator</_KapuschFacebookInteropSlice>
      <_KapuschFacebookInteropSlice Condition="'$(_KapuschFacebookInteropSlice)' == ''">ios-arm64</_KapuschFacebookInteropSlice>
    </PropertyGroup>
    <ItemGroup>
	  <NativeReference Include="$(_KapuschFacebookInteropIosWrapper)" Condition="'$(_KapuschFacebookLoginEnabled)' == 'True'">
        <Kind>Static</Kind>
        <ForceLoad>true</ForceLoad>
      </NativeReference>
	  <NativeReference Include="$(_KapuschFacebookShareInteropIosWrapper)" Condition="'$(_KapuschFacebookShareEnabled)' == 'True'">
		<Kind>Static</Kind>
		<ForceLoad>true</ForceLoad>
	  </NativeReference>
	  <!-- NativeFacebookShare uses static __Internal imports, so its symbols must link even when Share is not selected. -->
	  <NativeReference Include="$(_KapuschFacebookShareStubIosWrapper)" Condition="'$(_KapuschFacebookShareEnabled)' != 'True'">
		<Kind>Static</Kind>
		<ForceLoad>true</ForceLoad>
	  </NativeReference>
	  <!-- App Events only needs FBSDKCoreKit, which every selection links, and FacebookAppEvents uses static __Internal imports. -->
	  <NativeReference Include="$(_KapuschFacebookAppEventsIosWrapper)">
		<Kind>Static</Kind>
		<ForceLoad>true</ForceLoad>
	  </NativeReference>
      <NativeReference Include="$(_KapuschFacebookInteropFbDir)/FBAEMKit.xcframework">
        <Kind>Framework</Kind>
        <ForceLoad>true</ForceLoad>
      </NativeReference>
      <NativeReference Include="$(_KapuschFacebookInteropFbDir)/FBSDKCoreKit.xcframework">
        <Kind>Framework</Kind>
        <ForceLoad>true</ForceLoad>
      </NativeReference>
      <NativeReference Include="$(_KapuschFacebookInteropFbDir)/FBSDKCoreKit_Basics.xcframework">
        <Kind>Framework</Kind>
        <ForceLoad>true</ForceLoad>
      </NativeReference>
	  <NativeReference Include="$(_KapuschFacebookInteropFbDir)/FBSDKLoginKit.xcframework" Condition="'$(_KapuschFacebookLoginEnabled)' == 'True'">
		<Kind>Framework</Kind>
		<ForceLoad>true</ForceLoad>
	  </NativeReference>
	  <NativeReference Include="$(_KapuschFacebookInteropFbDir)/FBSDKShareKit.xcframework" Condition="'$(_KapuschFacebookShareEnabled)' == 'True'">
        <Kind>Framework</Kind>
        <ForceLoad>true</ForceLoad>
      </NativeReference>
	  <BundleResource Include="$(_KapuschFacebookInteropFbDir)/FBAEMKit.xcframework/$(_KapuschFacebookInteropSlice)/FBAEMKit.framework/PrivacyInfo.xcprivacy" LogicalName="FBAEMKit_PrivacyInfo.xcprivacy" />
	  <BundleResource Include="$(_KapuschFacebookInteropFbDir)/FBSDKCoreKit.xcframework/$(_KapuschFacebookInteropSlice)/FBSDKCoreKit.framework/PrivacyInfo.xcprivacy" LogicalName="FBSDKCoreKit_PrivacyInfo.xcprivacy" />
	  <BundleResource Include="$(_KapuschFacebookInteropFbDir)/FBSDKCoreKit_Basics.xcframework/$(_KapuschFacebookInteropSlice)/FBSDKCoreKit_Basics.framework/PrivacyInfo.xcprivacy" LogicalName="FBSDKCoreKit_Basics_PrivacyInfo.xcprivacy" />
	  <BundleResource Include="$(_KapuschFacebookInteropFbDir)/FBSDKLoginKit.xcframework/$(_KapuschFacebookInteropSlice)/FBSDKLoginKit.framework/PrivacyInfo.xcprivacy" LogicalName="FBSDKLoginKit_PrivacyInfo.xcprivacy" Condition="'$(_KapuschFacebookLoginEnabled)' == 'True'" />
	  <BundleResource Include="$(_KapuschFacebookInteropFbDir)/FBSDKShareKit.xcframework/$(_KapuschFacebookInteropSlice)/FBSDKShareKit.framework/PrivacyInfo.xcprivacy" LogicalName="FBSDKShareKit_PrivacyInfo.xcprivacy" Condition="'$(_KapuschFacebookShareEnabled)' == 'True'" />
    </ItemGroup>
  </Target>
</Project>
